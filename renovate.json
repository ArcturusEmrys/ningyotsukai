{
    "packageRules": [
        {
            "matchPackageNames": ["glam"],
            "allowedVersions": "< 0.29.0"
        },
        {
            "matchPackageNames": ["inox2d", "/^inox2d-/"],
            "enabled": false
        },
        {
            "matchPackageNames": ["wgpu", "/^wgpu-/", "wgpu-profiler"],
            "groupName": "wgpu"
        },
        {
            "matchPackageNames": ["pipewire", "libspa", "libspa-sys"],
            "groupName": "pipewire"
        },
        {
            "matchPackageNames": ["windows", "/^windows-/"],
            "groupName": "windows"
        }
    ]
}