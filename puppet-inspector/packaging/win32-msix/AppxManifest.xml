<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 rescap">
  <Identity Name="PuppetInspector" 
            Version="0.0.0.0"
            Publisher="CN=Arcturus Emrys" />
  <Properties>
    <DisplayName>Puppet Inspector</DisplayName>
    <PublisherDisplayName>Arcturus Emrys</PublisherDisplayName>
    <Logo>Icon/AppList.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19045.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en" />
  </Resources>
  <Applications>
    <Application
      Id="PuppetInspector"
      Executable="puppet-inspector.exe"
      uap10:RuntimeBehavior="packagedClassicApp" 
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Puppet Inspector"
        Description="A grimoire that describes the spells within a particular puppet."
        BackgroundColor="black"
        Square150x150Logo="Icon/AppList.png"
        Square44x44Logo="Icon/AppList.png">
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>