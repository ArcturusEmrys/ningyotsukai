<?xml version="1.0" encoding="UTF-8" ?>
<interface>
    <template class="PIRenderParam" parent="GtkBox">
        <property name="orientation">vertical</property>
        <child>
            <object class="GtkExpander">
                <property name="label-widget">
                    <object class="GtkLabel" id="param_name">
                    </object>
                </property>
                <property name="child">
                    <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                            <object class="GtkBox" id="x_param_box">
                                <property name="orientation">horizontal</property>
                                <child>
                                    <object class="GtkScale" id="x_param_scale">
                                        <property name="orientation">horizontal</property>
                                        <property name="adjustment">x_param</property>
                                        <property name="width-request">200</property>
                                        <property name="hexpand">true</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkEditableLabel" id="x_param_label">
                                        <property name="width-chars">8</property>
                                        <property name="max-width-chars">8</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkBox" id="y_param_box">
                                <child>
                                    <object class="GtkScale" id="y_param_scale">
                                        <property name="orientation">horizontal</property>
                                        <property name="adjustment">y_param</property>
                                        <property name="width-request">200</property>
                                        <property name="hexpand">true</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkEditableLabel" id="y_param_label">
                                        <property name="width-chars">8</property>
                                        <property name="max-width-chars">8</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </property>
            </object>
        </child>

        <object class="GtkAdjustment" id="x_param">
            <property name="lower">-1</property>
            <property name="upper">1</property>
            <property name="value">0</property>
            <property name="step_increment">0.1</property>
        </object>
        <object class="GtkAdjustment" id="y_param">
            <property name="lower">-1</property>
            <property name="upper">1</property>
            <property name="value">0</property>
            <property name="step_increment">0.1</property>
        </object>
    </template>
</interface>